#!/bin/sh
# Blocks secrets, the private team code and personal data.
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0
if git diff --cached -U0 | grep -E '^\+' | grep -qE 'gsk_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{30,}|sk-[A-Za-z0-9_-]{24,}|ghp_[A-Za-z0-9]{30,}|[a-z]+\.(am|as|mase)[0-9]{2}(dxb|d)[0-9]+@spjain'; then
  echo "  STOP: this commit contains something that looks like a key or a student email."; exit 1
fi
if echo "$files" | grep -qiE '(^|/)\.env($|\.)' && ! echo "$files" | grep -q '.env.example'; then
  echo "  STOP: do not commit .env files."; exit 1
fi
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] && [ "$(git config user.name)" != "Yashpetkar7" ]; then
  echo "  STOP: work on your own branch, for example: git switch -c $(git config user.name | tr 'A-Z ' 'a-z-')/work"; exit 1
fi
exit 0

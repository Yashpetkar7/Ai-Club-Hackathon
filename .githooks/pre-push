#!/bin/sh
# Team rule: push only to your own branch. Only Yash updates main. This stops accidents; GitHub rules are the lock.
current=$(git symbolic-ref --short HEAD 2>/dev/null)
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  if [ "$branch" = "main" ]; then
    if [ "$(git config user.name)" != "Yashpetkar7" ] || [ "$PUSH_OK" != "yash-said-yes" ]; then
      echo "  STOP: only Yash updates main. Push your own branch instead."; exit 1
    fi
    continue
  fi
  case "$branch" in
    nihal/evidence-ask|siddal/library-cite|hemanth/lab-governance|yash/integration) ;;
    *) echo "  STOP: '$branch' is not one of the team branches."; exit 1 ;;
  esac
  if [ "$local_sha" = "$zero" ]; then echo "  STOP: do not delete a team branch."; exit 1; fi
  if [ "$branch" != "$current" ]; then echo "  STOP: you are on '$current' but pushing to '$branch'. Push only your own branch."; exit 1; fi
  if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "  STOP: this would overwrite work already on '$branch'. Run: git pull --no-rebase origin $branch"; exit 1
  fi
done
exit 0
